        "path": "asr.vad.min_silence_duration",
        "expected": 0.5,
        "to": 1.2,
    },
    {
        "version": (2, 4, 1),
        "target": "config.json",
        "action": "replace_if_default",
        "path": "asr.vad.speech_pad_ms",
        "expected": 30,
        "to": 500,
