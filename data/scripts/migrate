#!/usr/bin/env python3
"""fcitx5-vinput standalone configuration migration utility.

Table-driven migration engine for config.json and vinput.conf.
Zero external dependencies: uses only Python 3 standard library.
Preserves symlink targets when performing atomic in-place updates.
"""

import argparse
import copy
import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

# -----------------------------------------------------------------------------
# Declarative Migration Rule Table
# -----------------------------------------------------------------------------
MIGRATION_RULES: list[dict[str, Any]] = [
    # v2.3.15: Normalize candidate_count to count and adaptors to adapters
    {
        "version": (2, 3, 15),
        "target": "config.json",
        "action": "rename",
        "path": "scenes.*.*.candidate_count",
        "new_key": "count",
    },
    {
        "version": (2, 3, 15),
        "target": "config.json",
        "action": "rename",
        "path": "llm.adaptors",
        "new_key": "adapters",
    },
    {
        "version": (2, 3, 15),
        "target": "vinput.conf",
        "action": "ini_replace",
        "old_key": "SceneMenuKey",
        "new_key": "MenuKey",
    },
    {
        "version": (2, 3, 15),
        "target": "vinput.conf",
        "action": "ini_remove",
        "key": "AsrMenuKey",
    },
    # v2.3.25: Decouple show_raw into raw_cand and raw_prev
    {
        "version": (2, 3, 25),
        "target": "config.json",
        "action": "rename",
        "path": "scenes.*.*.show_raw",
        "new_key": "raw_cand",
    },
    {
        "version": (2, 3, 25),
        "target": "config.json",
        "action": "ensure",
        "path": "scenes.*.*.raw_prev",
        "default": True,
    },
    # v2.3.27: Remove obsolete global.default_language
    {
        "version": (2, 3, 27),
        "target": "config.json",
        "action": "remove",
        "path": "global.default_language",
    },
    # v2.4.0: Remove obsolete HoldActivationDelay from addon conf
    {
        "version": (2, 4, 0),
        "target": "vinput.conf",
        "action": "ini_remove",
        "key": "HoldActivationDelay",
    },
    # v2.4.1: Upgrade legacy VAD acoustic defaults
    {
        "version": (2, 4, 1),
