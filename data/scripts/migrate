]


def default_config_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "vinput" / "config.json"


def default_conf_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "fcitx5" / "conf" / "vinput.conf"


def parse_version(v: Any) -> tuple[int, int, int]:
    if not v:
        return (0, 0, 0)
    cleaned = re.sub(r"^[vV]", "", str(v).strip())
    cleaned = cleaned.split("-")[0]
    parts = cleaned.split(".")
    nums = []
    for p in parts[:3]:
        try:
            nums.append(int(p))
        except ValueError:
            nums.append(0)
    while len(nums) < 3:
        nums.append(0)
    return (nums[0], nums[1], nums[2])


# -----------------------------------------------------------------------------
# Table-Driven Path Walker & Operations
# -----------------------------------------------------------------------------
def _apply_action_to_target(
    parent: dict[str, Any],
    key: str,
    desc: str,
    rule: dict[str, Any],
    changes: list[dict[str, str]],
) -> bool:
    action = rule["action"]

    if action == "rename":
        new_key = rule["new_key"]
        if key in parent:
            if new_key not in parent:
                parent[new_key] = parent.pop(key)
                changes.append(
                    {
                        "file": "config.json",
                        "description": f"{desc}.{key}: renamed '{key}' to '{new_key}'",
                    }
                )
            else:
                parent.pop(key, None)
                changes.append(
                    {
                        "file": "config.json",
                        "description": f"{desc}.{key}: removed obsolete duplicate key '{key}'",
                    }
                )
            return True

    elif action == "remove":
        if key in parent:
            del parent[key]
            changes.append(
                {
                    "file": "config.json",
                    "description": f"{desc}: removed obsolete field '{key}'",
                }
            )
            return True

    elif action == "ensure":
        if key not in parent:
            parent[key] = copy.deepcopy(rule["default"])
            changes.append(
                {
                    "file": "config.json",
                    "description": f"{desc}: added '{key}'",
                }
            )
            return True

    elif action == "replace_if_default":
        if key in parent:
            val = parent[key]
            expected = rule["expected"]
            matches = False
            if isinstance(expected, float) and isinstance(val, (int, float)):
                matches = abs(float(val) - expected) < 1e-4
            elif isinstance(expected, int) and isinstance(val, int):
                matches = val == expected

            if matches:
                parent[key] = rule["to"]
                changes.append(
                    {
                        "file": "config.json",
                        "description": f"{desc}.{key}: upgraded legacy default {expected} to {rule['to']}",
                    }
                )
                return True

    return False


def _walk_and_apply(
    node: Any,
    segments: list[str],
    desc: str,
    rule: dict[str, Any],
    changes: list[dict[str, str]],
) -> bool:
    if not segments:
        return False

    seg = segments[0]
    is_leaf = len(segments) == 1

    if is_leaf:
        if isinstance(node, dict):
            return _apply_action_to_target(node, seg, desc, rule, changes)
        return False

    sub_segments = segments[1:]
    any_changed = False

    if seg == "*":
        if isinstance(node, dict):
            for k, child in node.items():
                if _walk_and_apply(
                    child, sub_segments, f"{desc}.{k}", rule, changes
                ):
                    any_changed = True
        elif isinstance(node, list):
            for idx, child in enumerate(node):
                child_id = (
                    child.get("id", idx) if isinstance(child, dict) else idx
                )
                if _walk_and_apply(
                    child, sub_segments, f"{desc}[{child_id}]", rule, changes
                ):
                    any_changed = True
    elif isinstance(node, dict) and seg in node:
        if _walk_and_apply(
            node[seg], sub_segments, f"{desc}.{seg}", rule, changes
        ):
            any_changed = True

    return any_changed


def execute_table_rules_json(
    data: dict[str, Any], cur_ver: tuple[int, int, int], is_unversioned: bool
) -> tuple[bool, list[dict[str, str]]]:
    changes: list[dict[str, str]] = []
    any_changed = False

    for rule in MIGRATION_RULES:
        if rule.get("target") != "config.json":
            continue
        rule_ver = rule["version"]
        if cur_ver < rule_ver or is_unversioned:
            segments = rule["path"].split(".")
            root_seg = segments[0]
            if root_seg in data:
                if _walk_and_apply(
                    data[root_seg], segments[1:], root_seg, rule, changes
                ):
                    any_changed = True

    return any_changed, changes


def execute_table_rules_ini(
    lines: list[str], cur_ver: tuple[int, int, int], is_unversioned: bool
) -> tuple[bool, list[str], list[dict[str, str]]]:
    changes: list[dict[str, str]] = []
    current_lines = list(lines)
    any_changed = False

    for rule in MIGRATION_RULES:
        if rule.get("target") != "vinput.conf":
            continue
        rule_ver = rule["version"]
        if not (cur_ver < rule_ver or is_unversioned):
            continue

        action = rule["action"]
        new_lines: list[str] = []
        rule_triggered = False

        for line in current_lines:
            if action == "ini_replace":
                old_key = rule["old_key"]
                new_key = rule["new_key"]
                if line.startswith(f"{old_key}=") or line.startswith(
                    f"{old_key} "
                ):
                    eq_idx = line.find("=")
                    val = line[eq_idx:] if eq_idx != -1 else ""
                    new_lines.append(f"{new_key}{val}")
                    changes.append(
                        {
                            "file": "vinput.conf",
                            "description": f"replaced key '{old_key}' with '{new_key}'",
                        }
                    )
                    rule_triggered = True
                    any_changed = True
                    continue

            elif action == "ini_remove":
                key = rule["key"]
                if line.startswith(f"{key}=") or line.startswith(f"{key} "):
                    changes.append(
                        {
                            "file": "vinput.conf",
                            "description": f"removed obsolete key '{key}'",
                        }
                    )
                    rule_triggered = True
                    any_changed = True
                    continue

            new_lines.append(line)

        if rule_triggered:
            current_lines = new_lines

    return any_changed, current_lines, changes


# -----------------------------------------------------------------------------
# Main Migration Controller with Symlink Resolution
# -----------------------------------------------------------------------------
def main() -> int:
    parser = argparse.ArgumentParser(
        description="Migrate legacy fcitx5-vinput configuration files in-place."
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Preview migration changes without modifying files",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output report in JSON format",
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=default_config_path(),
        help="Path to config.json",
    )
    parser.add_argument(
        "--conf",
        type=Path,
        default=default_conf_path(),
        help="Path to vinput.conf",
    )

    args = parser.parse_args()

    # Symlink resolution: target actual files to preserve symlink pointers
    config_symlink = args.config
    conf_symlink = args.conf
    real_config_path = (
        config_symlink.resolve()
        if config_symlink.is_symlink()
        else config_symlink
    )
    real_conf_path = (
        conf_symlink.resolve() if conf_symlink.is_symlink() else conf_symlink
    )

    all_changes: list[dict[str, str]] = []
    error_msg = ""
    config_changed = False
    conf_changed = False

    raw_config = ""
    config_data: dict[str, Any] | None = None
    if real_config_path.is_file():
        try:
            raw_config = real_config_path.read_text(encoding="utf-8")
            config_data = json.loads(raw_config)
        except Exception as exc:
            error_msg = f"Failed to parse {real_config_path}: {exc}"

    initial_ver = (0, 0, 0)
    initial_unversioned = True
    if config_data is not None and isinstance(config_data, dict):
        cur_ver_str = config_data.get("vinput_version", "")
        initial_ver = parse_version(cur_ver_str)
        initial_unversioned = not cur_ver_str

        config_changed, cfg_changes = execute_table_rules_json(
            config_data, initial_ver, initial_unversioned
        )
        all_changes.extend(cfg_changes)

        # Update or add vinput_version if modified
        if config_changed or initial_unversioned:
            if config_data.get("vinput_version") != "2.4.1":
                config_data["vinput_version"] = "2.4.1"
                config_changed = True

    raw_conf = ""
    conf_lines: list[str] = []
    if real_conf_path.is_file():
        try:
            raw_conf = real_conf_path.read_text(encoding="utf-8")
            conf_lines = raw_conf.splitlines()
        except Exception as exc:
            if not error_msg:
                error_msg = f"Failed to read {real_conf_path}: {exc}"

    if conf_lines:
        conf_changed, new_conf_lines, ini_changes = execute_table_rules_ini(
            conf_lines, initial_ver, initial_unversioned
        )
        all_changes.extend(ini_changes)
        conf_lines = new_conf_lines

    needed = bool(all_changes) or config_changed or conf_changed
    config_backup = ""
    conf_backup = ""

    if needed and not args.dry_run and not error_msg:
        ts = datetime.now().strftime("%Y%m%d-%H%M%S")

        try:
            if (
                config_changed
                and config_data is not None
                and real_config_path.is_file()
            ):
                backup_dir = real_config_path.parent / "backups"
                backup_dir.mkdir(parents=True, exist_ok=True)
                backup_path = (
                    backup_dir / f"{real_config_path.name}.bak.{ts}"
                )
                backup_path.write_text(raw_config, encoding="utf-8")
                config_backup = str(backup_path)

                # Atomic write on real file path to preserve existing symlinks
                tmp_config = real_config_path.with_name(
                    f"{real_config_path.name}.tmp.{ts}"
                )
                try:
                    tmp_config.write_text(
                        json.dumps(config_data, indent=4, ensure_ascii=False)
                        + "\n",
                        encoding="utf-8",
                    )
                    os.replace(tmp_config, real_config_path)
                except OSError:
                    tmp_config.unlink(missing_ok=True)
                    raise

            if conf_changed and real_conf_path.is_file():
                backup_dir = real_conf_path.parent / "backups"
                backup_dir.mkdir(parents=True, exist_ok=True)
                backup_path = backup_dir / f"{real_conf_path.name}.bak.{ts}"
                backup_path.write_text(raw_conf, encoding="utf-8")
                conf_backup = str(backup_path)

                # Atomic write on real file path to preserve existing symlinks
                tmp_conf = real_conf_path.with_name(
                    f"{real_conf_path.name}.tmp.{ts}"
                )
                try:
                    tmp_conf.write_text(
                        "\n".join(conf_lines) + "\n", encoding="utf-8"
                    )
                    os.replace(tmp_conf, real_conf_path)
                except OSError:
                    tmp_conf.unlink(missing_ok=True)
                    raise
        except OSError as exc:
            error_msg = f"Failed to apply configuration migration: {exc}"

    applied = needed and not args.dry_run and not bool(error_msg)

    if args.json:
        report = {
            "needed": needed,
            "applied": applied,
            "dry_run": args.dry_run,
            "config_file": str(config_symlink),
            "conf_file": str(conf_symlink),
            "config_backup": config_backup,
            "conf_backup": conf_backup,
            "changes": all_changes,
            "error": error_msg,
        }
        print(json.dumps(report, indent=2, ensure_ascii=False))
        return 1 if error_msg else 0

    if error_msg:
        print(f"Error: {error_msg}", file=sys.stderr)
        return 1

    if not needed:
        print("Configuration is already up to date. No migration needed.")
        return 0

    if args.dry_run:
        print("Pending migration changes:")
    else:
        print("Configuration migration completed successfully:")

    if config_backup:
        print(f"Backed up core config to: {config_backup}")
    if conf_backup:
        print(f"Backed up addon config to: {conf_backup}")

    print(f"\n{'FILE':<15} {'CHANGE'}")
    print("-" * 60)
    for ch in all_changes:
        print(f"{ch['file']:<15} {ch['description']}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
