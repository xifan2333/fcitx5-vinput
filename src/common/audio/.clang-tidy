# PipeWire is one of the six documented C ABI hard boundaries (see
# .agents/skills/vinput-dev/principles/c-abi-boundaries.md). A pw_registry* and a pw_proxy* are the
# same object at the same address -- PipeWire itself returns it as `(struct pw_registry *) res` --
# but the public headers declare `struct pw_registry` as an incomplete type with no conversion path.
# reinterpret_cast is therefore the only C++ expression for that identity, and the guideline check
# would only force a per-line NOLINT here. Every other check stays enabled in this directory.
InheritParentConfig: true
Checks: >
  -cppcoreguidelines-pro-type-reinterpret-cast

# glaze uses template instantiation to pull in format support: glz::read is defined in
# glaze/core/read.hpp, but instantiating it for JSON also requires read_json_supported and the
# detail::read<json> specialization from glaze/json/read.hpp. misc-include-cleaner does not
# attribute instantiation uses, so any correct include set yields a false-positive
# "not used directly" / "not directly included" pair, and the repo forbids per-line NOLINT
# (ast-grep no-diagnostic-suppressions). Glaze headers are exempted from include-cleaner here
# only; every other check stays enabled in this directory.
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: 'glaze/.*'
